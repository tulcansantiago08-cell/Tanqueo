                <item android:color="#FF7A7A86" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Barras de la suspensión delantera -->
    <path
        android:fillColor="#7A7A86"
        android:pathData="M144,80 L131,52 L135,50 L148,78 Z" />
    <!-- Guardabarros delantero -->
    <path
        android:fillColor="#B9B9C2"
        android:pathData="M124,66 C130,56 154,55 161,63 L157,66 C151,60 136,61 129,69 Z" />
