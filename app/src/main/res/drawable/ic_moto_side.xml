    <path android:pathData="M110,66 L114,44 L122,24 L131,21 L146,33 L153,42 L149,54 C145,60 132,64 110,66 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="110"
                android:startY="44"
                android:endX="153"
                android:endY="44">
                <item android:color="#FF90909C" android:offset="0" />
                <item android:color="#FFA3A3AE" android:offset="0.35" />
                <item android:color="#FFF0F0F4" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Escudo de las piernas: la cara interna del carenaje, en sombra -->
    <path
        android:fillColor="#7A7A86"
        android:pathData="M110,66 L114,44 L121,28 L125,44 L121,63 Z" />
