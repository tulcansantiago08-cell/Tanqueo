<?xml version="1.0" encoding="utf-8"?>
<!-- Scooter grande vista de lado, dibujado a mano y sin marcas reales. Sigue la forma de un maxi
     scooter: carenaje delantero alto y anguloso con parabrisas, farola en punta, piso plano, sillín
     largo con escalón para el parrillero, cola en punta con agarradera, exosto grande al lado y
     ruedas con disco. El frente mira a la derecha. Mismo tamaño y estilo que ic_car_top. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="180dp"
    android:height="100dp"
    android:viewportWidth="180"
    android:viewportHeight="100">
    <!-- Llantas -->
    <path
        android:fillColor="#3E3E46"
        android:fillType="evenOdd"
        android:pathData="M21,78 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 Z M27,78 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z M123,78 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 Z M129,78 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z" />
    <!-- Rines claros con el centro hundido -->
    <path
        android:fillColor="#B9B9C2"
        android:fillType="evenOdd"
        android:pathData="M27,78 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z M31,78 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z M129,78 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z M133,78 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z" />
    <!-- Disco del freno delantero y centros -->
    <path
        android:fillColor="#7A7A86"
        android:fillType="evenOdd"
        android:pathData="M133,78 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z M137,78 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
    <path
        android:fillColor="#5C5C66"
        android:pathData="M36,78 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z M138,78 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    <!-- Bloque del motor y basculante -->
    <path
        android:fillColor="#6A6A75"
        android:pathData="M38,72 L76,64 C83,63 87,69 82,73 L46,84 C40,86 34,76 38,72 Z" />
    <!-- Amortiguador trasero -->
    <path
        android:fillColor="#4A4A54"
        android:pathData="M46,50 L53,72 L57,71 L50,49 Z" />
    <!-- Carrocería trasera: de la cola en punta al piso, más brillante arriba -->
    <path android:pathData="M8,44 L22,39 L62,43 L92,47 C97,48 99,53 96,57 L90,66 L64,68 C60,60 52,55 42,55 C33,55 26,58 21,61 L13,52 C10,49 8,47 8,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="50"
                android:startY="39"
                android:endX="50"
                android:endY="68">
                <item android:color="#FFF0F0F4" android:offset="0" />
                <item android:color="#FFA3A3AE" android:offset="0.55" />
                <item android:color="#FF90909C" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Pliegue deportivo de la carrocería -->
    <path
        android:fillColor="#7A7A86"
        android:pathData="M20,51 L90,55 L88,58 L23,55 Z" />
    <!-- Agarradera y calavera -->
    <path
        android:fillColor="#5C5C66"
        android:pathData="M10,40 L28,35 L29,38 L11,43 Z" />
    <path
        android:fillColor="#FF5A4F"
        android:pathData="M6,43 L16,40 L17,44 L8,47 Z" />
