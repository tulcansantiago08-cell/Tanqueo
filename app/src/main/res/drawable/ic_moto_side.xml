        android:fillColor="#B9B9C2"
        android:pathData="M90,61 L116,59 L118,66 L88,68 Z" />
    <path
        android:fillColor="#4A4A54"
        android:pathData="M86,68 L118,66 L116,71 L84,72 Z" />
