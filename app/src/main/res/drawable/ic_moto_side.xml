    <path
        android:fillColor="#4A4A54"
        android:pathData="M106,28 L126,23 L127,26 L107,31 Z" />
    <path
        android:fillColor="#2E2E36"
        android:pathData="M103,29 L110,27 L111,31 L104,33 Z" />
    <path
        android:fillColor="#5C5C66"
        android:pathData="M117,25 L113,12 L115,11 L119,24 Z M107,9 a5,3.5 0 1,0 10,0 a5,3.5 0 1,0 -10,0 Z" />
